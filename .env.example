# Copy to .env and fill in. .env is gitignored -- never commit it.
# Real values come from the team's password manager, not from chat/email.

# Supabase Postgres (leave USE_LOCAL_DB unset to use this)
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Or run against a local Postgres instead
USE_LOCAL_DB=
LOCAL_DB_NAME=boutique_crm
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=5432

# Supabase storage.
# SUPABASE_KEY is the publishable key: it can read the bucket and nothing else.
# SUPABASE_SERVICE_KEY is the service-role key and is what lets the server WRITE
# uploads. Without it Django falls back to the local disk, which on Render is
# wiped by the next deploy. It must never appear in the frontend, in a VITE_
# variable, or in an API response.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# Session lifetime, in seconds. The access token expires; the client renews it
# with the refresh token without the user noticing.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# List endpoints answer {count, next, previous, results}. This is the default
# page size; a caller may ask for up to 200 with ?page_size=.
API_PAGE_SIZE=50

# Push notifications. Unset means every notification is written and logged but
# delivered nowhere, which is the shipped default and needs no Firebase project.
# To deliver: PUSH_BACKEND=crm_api.push_fcm.send, plus a Firebase project id and
# a service-account JSON pointed at by GOOGLE_APPLICATION_CREDENTIALS.
PUSH_BACKEND=
FCM_PROJECT_ID=
FCM_CHANNEL_ID=boutique_orders

# Behind a TLS-terminating proxy (Render, Vercel, Cloudflare), Django only knows
# the request arrived over https from X-Forwarded-Proto. Trusted by default
# outside DEBUG; set False only if nothing in front overwrites that header.
TRUST_PROXY_SSL_HEADER=

# Where the test database lives. Set it to something outside the `test_*`
# namespace when two checkouts on one machine run suites at the same time.
TEST_DB_NAME=

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=

# Optional: email, Design Studio keys, seed passwords -- see settings.py for defaults.
